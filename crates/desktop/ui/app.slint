// lanPrint desktop UI. All user visible strings come from the `L` global so
// the Rust side can switch language instantly without restarting.

import { Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView } from "std-widgets.slint";

export struct DeviceItem {
    id: string,
    name: string,
    address: string,
    os: string,
    online: bool,
    cloud: bool,
    printer-count: int,
    selected: bool,
}

export struct PrinterItem {
    local-name: string,
    remote-name: string,
    device-id: string,
    display-name: string,
    driver: string,
    status: string,
    online: bool,
    supports-scan: bool,
    added: bool,
    has-password: bool,
    preferences: string,
}

export struct LocalPrinterItem {
    name: string,
    driver: string,
    status: string,
    supports-scan: bool,
    shared: bool,
    has-password: bool,
}

export struct DiscoveryItem {
    id: string,
    name: string,
    address: string,
    os: string,
    version: string,
    cloud: bool,
    shared-count: int,
    requires-password: bool,
}

