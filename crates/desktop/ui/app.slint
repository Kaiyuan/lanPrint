// lanPrint desktop UI. All user visible strings come from the `L` global so
// the Rust side can switch language instantly without restarting.

import { Palette } from "std-widgets.slint";

export global Theme {
    in-out property <int> appearance: 0;
    in-out property <int> accent-index: 0;
    out property <bool> system-dark: Palette.color-scheme == ColorScheme.dark;
    out property <bool> dark: appearance == 0 ? system-dark : appearance == 2;
    pure function accent-color(index: int, dark: bool) -> color {
        if (index == 1) { return dark ? #A78BFA : #7C5CFC; }
        if (index == 2) { return dark ? #F472B6 : #EC4899; }
        if (index == 3) { return dark ? #F87171 : #EF4444; }
        if (index == 4) { return dark ? #FBBF24 : #F59E0B; }
        if (index == 5) { return dark ? #4ADE80 : #22C55E; }
        if (index == 6) { return dark ? #A1A1AA : #71717A; }
        return dark ? #60A5FA : #2563EB;
    }
    out property <color> accent: accent-color(accent-index, dark);
    out property <color> accent-soft: accent.transparentize(dark ? 0.82 : 0.90);
    out property <bool> light: !dark;
    out property <color> bg: dark ? #0E0E0F : #F5F5F3;
    out property <color> toolbar: dark ? #171718 : #FFFFFF;
    out property <color> sidebar: dark ? #1A1A1C : #F9F9F7;
    out property <color> panel: dark ? #1B1B1D : #FFFFFF;
    out property <color> card: dark ? #1B1B1D : #FFFFFF;
    out property <color> card-hover: dark ? #232325 : #FAFAF8;
    out property <color> text: dark ? #F4F4F2 : #161616;
    out property <color> muted: dark ? #9C9C98 : #86867F;
    out property <color> tertiary: dark ? #6F6F6B : #A6A6A0;
    out property <color> border: dark ? #2B2B2D : #E7E7E2;
    out property <color> separator: dark ? #252527 : #EFEFEA;
    out property <color> control: dark ? #242426 : #FFFFFF;
    out property <color> control-hover: dark ? #2D2D30 : #F5F5F2;
    out property <color> control-pressed: dark ? #1E1E20 : #ECECE7;
    out property <color> segment-bg: dark ? #222224 : #F0F0EC;
    out property <color> field: dark ? #1E1E20 : #FFFFFF;
    out property <color> switch-off: dark ? #3C3C3E : #E3E3DD;
    out property <color> hover: dark ? #262628 : #F2F2EE;
    out property <color> overlay: dark ? #00000099 : #00000038;
    out property <color> success: dark ? #4ADE80 : #22A85A;
    out property <color> warning: dark ? #FBBF24 : #E8A317;
    out property <color> danger: dark ? #F87171 : #E5484D;
    out property <color> on-accent: #FFFFFF;
    out property <color> shadow: dark ? #00000066 : #00000014;
}


export struct PrinterItem {
    local-name: string,
    remote-name: string,
    device-id: string,
    display-name: string,
    driver: string,
    status: string,
    online: bool,
    supports-scan: bool,
    added: bool,
    has-password: bool,
    preferences: string,
}

export struct HostRow {
    kind: int,
    id: string,
    name: string,
    address: string,
    online: bool,
    cloud: bool,
    printer-count: int,
    expanded: bool,
    local-name: string,
    remote-name: string,
    display-name: string,
    driver: string,
    status: string,
    supports-scan: bool,
    added: bool,
    has-password: bool,
    preferences: string,
}

export struct LocalPrinterItem {    name: string,
    driver: string,
    status: string,
    supports-scan: bool,
    shared: bool,
    has-password: bool,
}

export struct DiscoveryItem {
    id: string,
    name: string,
    address: string,
    os: string,
    version: string,
    cloud: bool,
    shared-count: int,
    requires-password: bool,
}

