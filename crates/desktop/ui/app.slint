// lanPrint desktop UI. All user visible strings come from the `L` global so
// the Rust side can switch language instantly without restarting.

import { ScrollView, Palette } from "std-widgets.slint";

export global Theme {
    in-out property <int> appearance: 0;
    in-out property <int> accent-index: 0;
    out property <bool> system-dark: Palette.color-scheme == ColorScheme.dark;
    out property <bool> dark: appearance == 0 ? system-dark : appearance == 2;
    pure function accent-color(index: int, dark: bool) -> color {
        if (index == 1) { return dark ? #BF5AF2 : #AF52DE; }
        if (index == 2) { return dark ? #FF375F : #FF2D55; }
        if (index == 3) { return dark ? #FF453A : #FF3B30; }
        if (index == 4) { return dark ? #FF9F0A : #FF9500; }
        if (index == 5) { return dark ? #30D158 : #34C759; }
        if (index == 6) { return dark ? #98989D : #8E8E93; }
        return dark ? #0A84FF : #007AFF;
    }
    out property <color> accent: accent-color(accent-index, dark);
    out property <color> accent-soft: accent.transparentize(dark ? 0.78 : 0.88);
    out property <color> bg: dark ? #1C1C1E : #F2F2F7;
    out property <color> toolbar: dark ? #2C2C2E : #FFFFFF;
    out property <color> sidebar: dark ? #252527 : #F7F7F9;
    out property <color> panel: dark ? #2C2C2E : #FFFFFF;
    out property <color> card: dark ? #2C2C2E : #FFFFFF;
    out property <color> card-hover: dark ? #3A3A3C : #F9F9FB;
    out property <color> text: dark ? #F5F5F7 : #1D1D1F;
    out property <color> muted: dark ? #A1A1A6 : #6E6E73;
    out property <color> tertiary: dark ? #8E8E93 : #8E8E93;
    out property <color> border: dark ? #3A3A3C : #D9D9DE;
    out property <color> separator: dark ? #38383A : #E5E5EA;
    out property <color> control: dark ? #3A3A3C : #FFFFFF;
    out property <color> control-hover: dark ? #48484A : #F0F0F2;
    out property <color> control-pressed: dark ? #2C2C2E : #E5E5EA;
    out property <color> segment-bg: dark ? #3A3A3C : #E9E9ED;
    out property <color> field: dark ? #1C1C1E : #FFFFFF;
    out property <color> switch-off: dark ? #48484A : #E5E5EA;
    out property <color> hover: dark ? #3A3A3C : #ECECF0;
    out property <color> overlay: dark ? #00000099 : #00000033;
    out property <color> success: dark ? #30D158 : #34C759;
    out property <color> warning: dark ? #FF9F0A : #FF9500;
    out property <color> danger: dark ? #FF453A : #FF3B30;
    out property <color> on-accent: #FFFFFF;
}


export struct DeviceItem {
    id: string,
    name: string,
    address: string,
    os: string,
    online: bool,
    cloud: bool,
    printer-count: int,
    selected: bool,
}

export struct PrinterItem {
    local-name: string,
    remote-name: string,
    device-id: string,
    display-name: string,
    driver: string,
    status: string,
    online: bool,
    supports-scan: bool,
    added: bool,
    has-password: bool,
    preferences: string,
}

export struct LocalPrinterItem {
    name: string,
    driver: string,
    status: string,
    supports-scan: bool,
    shared: bool,
    has-password: bool,
}

export struct DiscoveryItem {
    id: string,
    name: string,
    address: string,
    os: string,
    version: string,
    cloud: bool,
    shared-count: int,
    requires-password: bool,
}

