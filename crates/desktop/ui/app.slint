component IconPrinter inherits Rectangle {
    in property <color> tint: Theme.text;
    width: 24px;
    height: 24px;
    Rectangle {
        x: 6px; y: 1px; width: 12px; height: 7px;
        border-radius: 1px; border-width: 1px; border-color: tint;
        background: #00000000;
    }
    Rectangle {
        y: 8px; width: 24px; height: 10px;
        border-radius: 3px; border-width: 1px; border-color: tint;
        background: tint.transparentize(0.86);
    }
    Rectangle {
        x: 6px; y: 17px; width: 12px; height: 6px;
        border-radius: 1px; border-width: 1px; border-color: tint;
        background: Theme.panel;
    }
    Rectangle {
        x: 4px; y: 11px; width: 3px; height: 3px;
        border-radius: 2px; background: Theme.success;
    }
}

component LangButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 34px;
    horizontal-stretch: 1;
    border-radius: 9px;
    background: selected ? Theme.text : Theme.control;
    border-width: 1px;
    border-color: selected ? Theme.text : Theme.border;
    Text {
        text: root.text;
        color: root.selected ? Theme.panel : Theme.text;
        font-size: 12px;
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    animate background { duration: 120ms; }
}

component StatusDot inherits Rectangle {
    in property <bool> online: true;
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background: online ? Theme.success : Theme.tertiary;
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.segment-bg;
    in property <color> foreground: Theme.muted;
    height: 22px;
    border-radius: 7px;
    background: tone;
    width: label.width + 16px;
    label := Text {
        x: 8px;
        text: root.text;
        color: root.foreground;
        font-size: 11px;
        vertical-alignment: center;
        height: parent.height;
    }
}

component ButtonIcon inherits Rectangle {
    in property <image> source;
    in property <color> tint: Theme.text;
    width: 14px;
    height: 14px;
    Image {
        source: root.source;
        width: 14px;
        height: 14px;
        y: 2px;
        colorize: root.tint;
    }
}

component TextButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> small: false;
    callback clicked();
    height: small ? 28px : 32px;
    min-width: small ? 68px : 86px;
    horizontal-stretch: 0;
    border-radius: 9px;
    border-width: primary ? 0px : 1px;
    border-color: Theme.border;
    background: !enabled ? Theme.control-pressed
        : primary ? (ta.pressed ? Theme.accent.transparentize(0.15) : Theme.accent)
        : (ta.pressed ? Theme.control-pressed : (ta.has-hover ? Theme.control-hover : Theme.control));
    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: small ? 9px : 12px;
        padding-right: small ? 9px : 12px;
        spacing: root.has-icon ? 6px : 0px;
        alignment: center;
        cross-axis-alignment: center;
        if root.has-icon : ButtonIcon {
            source: root.icon;
            tint: !root.enabled ? Theme.tertiary : (root.primary ? Theme.on-accent : Theme.muted);
        }
        Text {
            text: root.text;
            color: !enabled ? Theme.tertiary : (primary ? Theme.on-accent : Theme.text);
            font-size: small ? 11px : 12px;
            font-weight: primary ? 600 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
            height: parent.height;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
}

component IconButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.hover : #00000000;
    Text {
        text: root.text;
        color: enabled ? Theme.muted : Theme.tertiary;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    animate background { duration: 100ms; }
}

component WindowButton inherits Rectangle {
    in property <image> icon;
    in property <bool> danger: false;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: 7px;
    background: ta.pressed ? Theme.control-pressed
        : ta.has-hover ? (danger ? Theme.danger : Theme.hover) : #00000000;
    Image {
        source: root.icon;
        width: 12px;
        height: 12px;
        x: (parent.width - 12px) / 2;
        y: (parent.height - 12px) / 2 + 1px;
        colorize: root.danger && ta.has-hover ? #FFFFFF : Theme.muted;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    animate background { duration: 100ms; }
}

component Switch inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 40px;
    height: 24px;
    border-radius: 12px;
    background: checked ? Theme.accent : Theme.switch-off;
    Rectangle {
        x: checked ? parent.width - 22px : 2px;
        y: 2px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: #FFFFFF;
        border-width: 0.5px;
        border-color: #00000020;
        drop-shadow-blur: 1px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000028;
        animate x { duration: 120ms; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(!root.checked); }
    }
    animate background { duration: 120ms; }
}

component InputBox inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password: false;
    in property <bool> enabled: true;
    height: 34px;
    border-radius: 9px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    background: Theme.field;
    input := TextInput {
        x: 11px;
        width: parent.width - 22px;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        input-type: root.password ? InputType.password : InputType.text;
        color: Theme.text;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.on-accent;
        font-size: 13px;
        single-line: true;
        vertical-alignment: center;
    }
    if root.text == "" && root.placeholder != "" : Text {
        x: 12px;
        text: root.placeholder;
        color: Theme.tertiary;
        font-size: 13px;
        vertical-alignment: center;
        height: parent.height;
    }
    animate border-color { duration: 100ms; }
}

component Segmented inherits Rectangle {
    in property <[string]> labels;
    in-out property <int> current: 0;
    callback changed(int);
    height: 32px;
    border-radius: 10px;
    background: Theme.segment-bg;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for label[i] in root.labels : Rectangle {
            horizontal-stretch: 1;
            border-radius: 7px;
            background: root.current == i ? Theme.panel : #00000000;
            border-width: root.current == i ? 1px : 0px;
            border-color: Theme.border;
            drop-shadow-blur: root.current == i ? 3px : 0px;
            drop-shadow-offset-y: 1px;
            drop-shadow-color: Theme.shadow;
            Text {
                text: label;
                color: root.current == i ? Theme.text : Theme.muted;
                font-size: 12px;
                font-weight: root.current == i ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
            ta := TouchArea {
                clicked => {
                    root.current = i;
                    root.changed(i);
                }
            }
        }
    }
}

/// Compact dropdown used for paper sizes and input trays. The popup is a
/// plain list so it keeps the app's look instead of the platform style.
component Select inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current: -1;
    in property <string> unset-label: "";
    callback changed(int);
    height: 34px;
    border-radius: 9px;
    border-width: 1px;
    border-color: pop.has-hover ? Theme.accent : Theme.border;
    background: Theme.field;
    Text {
        x: 11px;
        width: parent.width - 34px;
        height: parent.height;
        text: root.current >= 0 && root.current < root.options.length ? root.options[root.current] : root.unset-label;
        color: root.current >= 0 ? Theme.text : Theme.tertiary;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    Image {
        x: parent.width - 26px;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        source: @image-url("assets/icons/chevron-down.svg");
        colorize: Theme.muted;
    }
    pop := TouchArea {
        clicked => { list.show(); }
    }
    list := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: (root.unset-label == "" ? root.options.length : root.options.length + 1) * 30px + 8px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: Theme.shadow;
            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                if root.unset-label != "" : Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: none-ta.has-hover ? Theme.hover : #00000000;
                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: root.unset-label;
                        color: root.current < 0 ? Theme.accent : Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    none-ta := TouchArea {
                        clicked => {
                            root.current = -1;
                            root.changed(-1);
                            list.close();
                        }
                    }
                }
                for option[i] in root.options : Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: item-ta.has-hover ? Theme.hover : #00000000;
                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: option;
                        color: root.current == i ? Theme.accent : Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    item-ta := TouchArea {
                        clicked => {
                            root.current = i;
                            root.changed(i);
                            list.close();
                        }
                    }
                }
            }
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();
    height: 34px;
    border-radius: 8px;
    background: selected ? Theme.hover : (ta.has-hover ? Theme.hover : #00000000);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        cross-axis-alignment: center;
        ButtonIcon {
            source: root.icon;
            tint: selected ? Theme.accent : Theme.muted;
        }
        Text {
            text: root.label;
            color: root.selected ? Theme.text : Theme.muted;
            font-size: 12px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Card inherits Rectangle {
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 14px;
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.shadow;
}

/// Flickable container with a slim overlay scrollbar that matches the app's
/// rounded, low-contrast visual language.
component AppScrollView inherits Rectangle {
    clip: true;

    property <length> max-offset: max(0px, flickable.content-height - flickable.height);
    property <length> track-height: max(0px, self.height - 12px);
    property <length> thumb-height: min(
        track-height,
        max(28px, track-height * flickable.height / max(flickable.content-height, 1px))
    );
    property <bool> scrollable: max-offset > 0px;

    flickable := Flickable {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        interactive: true;
        @children
    }

    thumb := Rectangle {
        x: root.width - 11px;
        y: 6px + (track-height - thumb-height) * clamp(-flickable.content-y / max(1px, max-offset), 0, 1);
        width: 6px;
        height: root.thumb-height;
        border-radius: 3px;
        background: bar.has-hover || bar.pressed
            ? Theme.text.transparentize(0.4)
            : Theme.text.transparentize(0.65);
        visible: root.scrollable;
        animate background { duration: 120ms; }
    }

    bar := TouchArea {
        x: parent.width - 16px;
        y: 0px;
        width: 16px;
        height: parent.height;
        enabled: root.scrollable;
        property <length> start-mouse: 0px;
        property <length> start-content: 0px;

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.start-mouse = self.mouse-y;
                self.start-content = flickable.content-y;
            }
        }

        moved => {
            if (self.pressed && root.max-offset > 0px) {
                let factor = root.max-offset / max(1px, root.track-height - root.thumb-height);
                flickable.content-y = clamp(
                    self.start-content - (self.mouse-y - self.start-mouse) * factor,
                    -root.max-offset,
                    0px
                );
            }
        }
    }
}

component SectionTitle inherits Text {
    color: Theme.text;
    font-size: 13px;
    font-weight: 600;
}

component MutedText inherits Text {
    color: Theme.muted;
    font-size: 11px;
}

export component MainWindow inherits Window {
    title: "lanPrint";
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 640px;
    preferred-height: 740px;
    min-width: 520px;
    min-height: 620px;
    background: Theme.bg;
    icon: @image-url("assets/lanprint-icon.png");

    in-out property <[PrinterItem]> printers: [];
    in-out property <[HostRow]> rows: [];
    in-out property <[LocalPrinterItem]> local-printers: [];
    in-out property <[DiscoveryItem]> discoveries: [];
    in-out property <[string]> language-names: ["简体中文", "繁體中文", "English", "Français", "Deutsch", "Italiano", "Español", "日本語", "한국어"];
    in-out property <int> language-index: 0;
    in-out property <int> appearance-index: 0;
    in-out property <int> accent-index: 0;
    in-out property <string> selected-device: "";
    in-out property <bool> busy: false;
    in-out property <string> status-text: "";
    in-out property <string> cloud-status: "";
    in-out property <string> share-code: "";
    in-out property <string> version-text: "";
    in-out property <bool> host-password-set: false;
    in-out property <bool> autostart: true;
    in-out property <string> host-password-input: "";
    in-out property <string> cloud-server: "";
    in-out property <string> cloud-code: "";
    in-out property <bool> cloud-enabled: false;
    in-out property <string> toast-text: "";
    in-out property <bool> toast-open: false;

    in-out property <bool> connect-open: false;
    in-out property <int> connect-tab: 0;
    in-out property <bool> connect-scanning: false;
    in-out property <bool> connect-testing: false;
    in-out property <string> connect-name: "";
    in-out property <string> connect-address: "";
    in-out property <string> connect-code: "";
    in-out property <string> connect-error: "";
    in-out property <string> connect-ok: "";
    in-out property <bool> connect-cloud-on: false;
    in-out property <string> connect-cloud-server: "";
    in-out property <string> connect-cloud-code: "";

    in-out property <bool> settings-open: false;
    in-out property <int> settings-tab: 0;
    in-out property <bool> all-printers-open: false;
    in-out property <string> all-printers-name: "";
    in-out property <string> all-printers-id: "";

    in-out property <bool> password-open: false;
    in-out property <string> password-target: "";
    in-out property <int> password-kind: 0;
    in-out property <string> password-input: "";
    in-out property <string> password-title: "";

    in-out property <bool> scan-open: false;
    in-out property <string> scan-target: "";
    in-out property <int> scan-resolution-index: 2;
    in-out property <int> scan-color-index: 0;
    in-out property <int> scan-source-index: 0;
    in-out property <bool> scan-busy: false;

    in-out property <bool> first-run-open: false;
    in-out property <string> first-run-password: "";

    // Per-printer job settings (stored on the client, applied on the host).
    in-out property <bool> job-open: false;
    in-out property <string> job-target: "";
    in-out property <string> job-title-text: "";
    in-out property <bool> job-has-duplex: false;
    in-out property <bool> job-has-booklet: false;
    in-out property <bool> job-has-color: false;
    in-out property <int> job-duplex-index: 0;
    in-out property <bool> job-booklet: false;
    in-out property <int> job-color-index: 0;
    in-out property <[string]> job-papers: [];
    in-out property <int> job-paper-index: 0;
    in-out property <[string]> job-sources: [];
    in-out property <int> job-source-index: -1;
    in-out property <int> job-copies: 1;
    in-out property <int> job-max-copies: 99;

    callback refresh();
    callback open-connect();
    callback open-settings();
    callback minimize-window();
    callback toggle-expand(string);
    callback list-all-printers(string);
    callback disconnect-all(string);
    callback remove-device(string);
    callback add-printer(string, string, string);
    callback remove-printer(string);
    callback test-print(string);
    callback open-preferences(string);
    callback save-job-settings();
    callback close-job-settings();
    callback open-scan(string);
    callback start-scan(string, int, int, int);
    callback test-connection(string, string, string, string, string, bool);
    callback save-connection(string, string, string, string, string, bool);
    callback scan-lan();
    callback pick-discovery(string);
    callback close-connect();
    callback language-changed(string);
    callback appearance-changed(int);
    callback accent-changed(int);
    callback set-autostart(bool);
    callback set-host-password(string);
    callback share-printer(string, bool);
    callback printer-password(string, string);
    callback edit-printer-password(string);
    callback cloud-save(bool, string, string);
    callback copy-share-code();
    callback password-confirm(int, string, string);
    callback close-password();
    callback close-scan();
    callback toast-close();
    callback quit-app();
    callback open-docs();
    callback open-logs();
    callback open-scan-folder();
    callback set-first-run-password(string);
    callback skip-first-run();
    callback close-overlays();

    Timer {
        interval: 4s;
        running: root.toast-open;
        triggered => { root.toast-open = false; }
    }

    // ------------------------------------------------------------------- body
    Rectangle {
        y: 64px;
        width: parent.width;
        height: parent.height - 64px - 30px;
        background: Theme.bg;

        if root.rows.length == 0 : Rectangle {
            width: parent.width;
            height: parent.height;
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                alignment: center;
                spacing: 12px;
                Rectangle {
                    width: parent.width;
                    height: 72px;
                    Rectangle {
                        x: (parent.width - 72px) / 2;
                        width: 72px;
                        height: 72px;
                        border-radius: 18px;
                        background: Theme.card;
                        border-width: 1px;
                        border-color: Theme.border;
                        drop-shadow-blur: 16px;
                        drop-shadow-offset-y: 6px;
                        drop-shadow-color: Theme.shadow;
                        Image { source: @image-url("assets/lanprint-icon.png"); width: parent.width; height: parent.height; }
                    }
                }
                Text { text: L.empty-devices-title; color: Theme.text; font-size: 17px; font-weight: 600; horizontal-alignment: center; width: parent.width; }
                Text {
                    text: L.empty-devices-desc;
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    width: parent.width;
                }
                Rectangle {
                    width: parent.width;
                    height: 32px;
                    TextButton {
                        x: (parent.width - 140px) / 2;
                        width: 140px;
                        text: L.connect-device;
                        icon: @image-url("assets/icons/plus-circle.svg");
                        has-icon: true;
                        primary: true;
                        clicked => { root.open-connect(); }
                    }
                }
            }
        }

        if root.rows.length > 0 : AppScrollView {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 16px;
                padding-bottom: 20px;
                spacing: 8px;
                width: parent.width;
                alignment: start;

                for row in root.rows : Rectangle {
                    height: row.kind == 0 ? 76px : 108px;
                    background: transparent;

                    if row.kind == 0 : Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        border-radius: 14px;
                        background: row.expanded ? Theme.card-hover : Theme.card;
                        border-width: 1px;
                        border-color: row.expanded ? Theme.accent : Theme.border;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;
                            cross-axis-alignment: center;
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 11px;
                                background: row.online ? Theme.accent-soft : Theme.control;
                                IconPrinter { x: 8px; y: 8px; tint: row.online ? Theme.accent : Theme.tertiary; }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                alignment: center;
                                Text { text: row.name; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                                Text {
                                    text: row.expanded && row.printer-count == 0 ? L.no-connected-printers : row.address;
                                    color: Theme.muted;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if row.cloud : Badge { text: L.device-cloud; }
                            Badge { text: row.printer-count + " " + L.shared-printers; }
                            StatusDot { online: row.online; }
                            ButtonIcon {
                                source: row.expanded ? @image-url("assets/icons/chevron-down.svg") : @image-url("assets/icons/chevron-right.svg");
                                tint: Theme.muted;
                            }
                        }
                        TouchArea { clicked => { root.toggle-expand(row.id); } }
                        ContextMenuArea {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            Menu {
                                MenuItem {
                                    title: row.expanded ? L.collapse : L.expand;
                                    icon: row.expanded ? @image-url("assets/icons/chevron-down.svg") : @image-url("assets/icons/chevron-right.svg");
                                    activated => { root.toggle-expand(row.id); }
                                }
                                MenuItem {
                                    title: L.list-all-printers;
                                    icon: @image-url("assets/icons/list.svg");
                                    activated => { root.list-all-printers(row.id); }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: L.disconnect-all;
                                    icon: @image-url("assets/icons/disconnect.svg");
                                    activated => { root.disconnect-all(row.id); }
                                }
                            }
                        }
                    }

                    if row.kind == 1 : Rectangle {
                        x: 24px;
                        y: 0px;
                        width: parent.width - 24px;
                        height: parent.height;
                        border-radius: 12px;
                        background: Theme.card;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 10px;
                                cross-axis-alignment: center;
                                Rectangle {
                                    width: 34px;
                                    height: 34px;
                                    border-radius: 9px;
                                    background: Theme.segment-bg;
                                    IconPrinter { x: 5px; y: 5px; tint: Theme.accent; }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    alignment: center;
                                    Text { text: row.display-name; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                                    Text { text: row.driver; color: Theme.muted; font-size: 11px; overflow: elide; }
                                    Text { text: row.preferences; color: Theme.tertiary; font-size: 10px; overflow: elide; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                if row.supports-scan : Badge { text: L.scan-support; }
                                StatusDot { online: row.online; }
                                Text { text: row.status; color: row.online ? Theme.success : Theme.tertiary; font-size: 11px; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle { horizontal-stretch: 1; }
                                if row.supports-scan : TextButton { text: L.scan; icon: @image-url("assets/icons/scan.svg"); has-icon: true; small: true; clicked => { root.open-scan(row.local-name); } }
                                TextButton { text: L.print-test; icon: @image-url("assets/icons/printer.svg"); has-icon: true; small: true; clicked => { root.test-print(row.local-name); } }
                                TextButton { text: L.job-settings; icon: @image-url("assets/icons/sliders.svg"); has-icon: true; small: true; clicked => { root.open-preferences(row.local-name); } }
                                TextButton { text: L.remove; icon: @image-url("assets/icons/trash.svg"); has-icon: true; small: true; clicked => { root.remove-printer(row.local-name); } }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------------------------------------------------------------- toolbar
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 64px;
        background: Theme.toolbar;
        Rectangle {
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: Theme.separator;
        }
        WindowMoveArea {
            HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                padding-left: 20px;
                padding-right: 12px;
                spacing: 8px;
                cross-axis-alignment: center;
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 7px;
                    Image { source: @image-url("assets/lanprint-icon.png"); width: parent.width; height: parent.height; }
                }
                if root.width > 600px : Text { text: "lanPrint"; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                if root.busy : Text { text: "…"; color: Theme.accent; font-size: 15px; vertical-alignment: center; }
                TextButton { text: L.refresh; icon: @image-url("assets/icons/refresh.svg"); has-icon: true; clicked => { root.refresh(); } }
                TextButton {
                    text: L.connect-device;
                    icon: @image-url("assets/icons/plus-circle.svg");
                    has-icon: true;
                    primary: true;
                    clicked => { root.open-connect(); }
                }
                TextButton { text: L.settings; icon: @image-url("assets/icons/gear.svg"); has-icon: true; clicked => { root.open-settings(); } }
                Rectangle { width: 6px; }
                WindowButton {
                    icon: @image-url("assets/icons/win-minimize.svg");
                    clicked => { root.minimize-window(); }
                }
                WindowButton {
                    icon: root.maximized ? @image-url("assets/icons/win-restore.svg") : @image-url("assets/icons/win-maximize.svg");
                    clicked => { root.maximized = !root.maximized; }
                }
                WindowButton {
                    icon: @image-url("assets/icons/win-close.svg");
                    danger: true;
                    clicked => { root.close(); }
                }
            }
        }
    }

    // -------------------------------------------------------------- status bar
    Rectangle {
        y: parent.height - 30px;
        width: parent.width;
        height: 30px;
        background: Theme.toolbar;
        Rectangle { y: 0px; width: parent.width; height: 1px; background: Theme.separator; }
        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 8px;
            alignment: start;
            cross-axis-alignment: center;
            StatusDot { online: root.status-text != ""; }
            Text { text: root.status-text; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
            if root.share-code != "" : Text { text: L.share-code + ": " + root.share-code; color: Theme.accent; font-size: 10px; vertical-alignment: center; }
            if root.cloud-status != "" : Text {
                text: root.cloud-status;
                color: root.cloud-status == L.cloud-connected ? Theme.success : Theme.warning;
                font-size: 10px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text { text: "v" + root.version-text; color: Theme.tertiary; font-size: 9px; vertical-alignment: center; }
        }
    }

    // ---------------------------------------------------------- connect sheet
    if root.connect-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.overlay;
        block := TouchArea { }
        Rectangle {
            width: Math.min(parent.width - 24px, 600px);
            height: Math.min(parent.height - 40px, 570px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 18px;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: Theme.shadow;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    Text { text: L.connect-title; color: Theme.text; font-size: 17px; font-weight: 600; }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton { text: "×"; clicked => { root.close-connect(); } }
                }
                Segmented {
                    labels: [L.connect-scan-tab, L.connect-manual-tab];
                    current: root.connect-tab;
                    changed(i) => { root.connect-tab = i; }
                }
                if root.connect-tab == 0 : VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: L.scanned-devices; color: Theme.muted; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        TextButton { text: root.connect-scanning ? L.scanning : L.scan-lan; small: true; enabled: !root.connect-scanning; clicked => { root.scan-lan(); } }
                    }
                    if root.discoveries.length == 0 : Rectangle {
                        vertical-stretch: 1;
                        Text {
                            text: root.connect-scanning ? L.scanning-lan : L.scan-empty;
                            color: Theme.tertiary;
                            font-size: 12px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width - 30px;
                        }
                    }
                    if root.discoveries.length > 0 : AppScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            width: parent.width;
                            padding-right: 10px;
                            spacing: 7px;
                            for d in root.discoveries : Card {
                                height: 58px;
                                HorizontalLayout {
                                    padding: 10px;
                                    spacing: 9px;
                                    Rectangle {
                                        width: 30px; height: 30px; border-radius: 7px; background: Theme.control;
                                        IconPrinter { x: 3px; y: 3px; tint: Theme.accent; }
                                    }
                                    VerticalLayout {
                                        spacing: 1px; alignment: center;
                                        Text { text: d.name; color: Theme.text; font-size: 12px; font-weight: 600; }
                                        Text { text: d.address + " · " + d.os + " · v" + d.version; color: Theme.muted; font-size: 10px; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    if d.cloud : Badge { text: L.device-cloud; tone: Theme.accent; foreground: Theme.on-accent; }
                                    TextButton {
                                        text: L.connect;
                                        small: true;
                                        primary: true;
                                        clicked => {
                                            root.connect-name = d.name;
                                            root.connect-address = d.address;
                                            root.connect-tab = 1;
                                            root.connect-cloud-on = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    TextButton { text: L.manual-input; horizontal-stretch: 1; clicked => { root.connect-tab = 1; } }
                }
                if root.connect-tab == 1 : VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 9px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: L.cloud-client-toggle; color: Theme.text; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                        Switch { checked: root.connect-cloud-on; toggled(v) => { root.connect-cloud-on = v; } }
                    }
                    if root.connect-cloud-on : VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        alignment: start;
                        Text { text: L.server-url; color: Theme.muted; font-size: 11px; }
                        InputBox { text <=> root.connect-cloud-server; placeholder: L.bridge-url-placeholder; }
                        Text { text: L.share-code; color: Theme.muted; font-size: 11px; }
                        InputBox { text <=> root.connect-cloud-code; placeholder: L.share-code-placeholder; }
                        MutedText { text: L.cloud-connect-desc; width: parent.width; wrap: word-wrap; }
                    }
                    if !root.connect-cloud-on : VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        alignment: start;
                        Text { text: L.host-name-or-ip; color: Theme.muted; font-size: 11px; }
                        InputBox { text <=> root.connect-address; placeholder: L.host-placeholder; }
                    }
                    Text { text: L.access-code; color: Theme.muted; font-size: 11px; }
                    InputBox { text <=> root.connect-code; placeholder: L.access-code-placeholder; password: true; }
                    if root.connect-error != "" : Text { text: root.connect-error; color: Theme.danger; font-size: 11px; wrap: word-wrap; }
                    if root.connect-ok != "" : Text { text: root.connect-ok; color: Theme.success; font-size: 11px; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        TextButton {
                            text: root.connect-testing ? L.testing : L.test-connection;
                            enabled: !root.connect-testing;
                            clicked => {
                                root.test-connection(root.connect-name, root.connect-address, root.connect-code, root.connect-cloud-server, root.connect-cloud-code, root.connect-cloud-on);
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        TextButton { text: L.cancel; clicked => { root.close-connect(); } }
                        TextButton {
                            text: L.save-device;
                            primary: true;
                            clicked => {
                                root.save-connection(root.connect-name, root.connect-address, root.connect-code, root.connect-cloud-server, root.connect-cloud-code, root.connect-cloud-on);
                            }
                        }
                    }
                }
            }
        }
    }

    // --------------------------------------------------------- settings sheet
    if root.settings-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.overlay;
        TouchArea { }
        Rectangle {
            width: Math.min(parent.width - 24px, 880px);
            height: Math.min(parent.height - 40px, 620px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 18px;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: Theme.shadow;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 0px;
                spacing: 0px;
                Rectangle {
                    height: 52px;
                    background: Theme.panel;
                    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.separator; }
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 14px;
                        width: parent.width;
                        height: parent.height;
                        Text { text: L.settings-title; color: Theme.text; font-size: 17px; font-weight: 600; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        IconButton { text: "×"; clicked => { root.settings-open = false; } }
                    }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    Rectangle {
                        width: 180px;
                        vertical-stretch: 1;
                        background: Theme.sidebar;
                        Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.separator; }
                        VerticalLayout {
                            padding: 12px;
                            spacing: 3px;
                            NavItem { label: L.general; icon: @image-url("assets/icons/sliders.svg"); selected: root.settings-tab == 0; clicked => { root.settings-tab = 0; } }
                            NavItem { label: L.share-printers; icon: @image-url("assets/icons/printer.svg"); selected: root.settings-tab == 1; clicked => { root.settings-tab = 1; } }
                            NavItem { label: L.cloud-title; icon: @image-url("assets/icons/cloud.svg"); selected: root.settings-tab == 2; clicked => { root.settings-tab = 2; } }
                            NavItem { label: L.about; icon: @image-url("assets/icons/info.svg"); selected: root.settings-tab == 3; clicked => { root.settings-tab = 3; } }
                            Rectangle { vertical-stretch: 1; }
                            MutedText { text: "lanPrint " + root.version-text; }
                        }
                    }
                    AppScrollView {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;
                            width: parent.width;
                            alignment: start;

                            if root.settings-tab == 0 : VerticalLayout {
                                spacing: 16px;
                                Card {
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 12px;
                                        SectionTitle { text: L.appearance; }
                                        MutedText { text: L.appearance-desc; width: parent.width; wrap: word-wrap; }
                                        Segmented {
                                            labels: [L.appearance-system, L.appearance-light, L.appearance-dark];
                                            current: root.appearance-index;
                                            changed(i) => { root.appearance-index = i; root.appearance-changed(i); }
                                        }
                                        HorizontalLayout {
                                            spacing: 9px;
                                            Text { text: L.accent-color; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                                            Rectangle {
                                                width: 24px; height: 24px; border-radius: 12px; background: #2563EB;
                                                border-width: root.accent-index == 0 ? 3px : 1px; border-color: root.accent-index == 0 ? Theme.text : Theme.border;
                                                TouchArea { clicked => { root.accent-index = 0; root.accent-changed(0); } }
                                            }
                                            Rectangle {
                                                width: 24px; height: 24px; border-radius: 12px; background: #7C5CFC;
                                                border-width: root.accent-index == 1 ? 3px : 1px; border-color: root.accent-index == 1 ? Theme.text : Theme.border;
                                                TouchArea { clicked => { root.accent-index = 1; root.accent-changed(1); } }
                                            }
                                            Rectangle {
                                                width: 24px; height: 24px; border-radius: 12px; background: #EC4899;
                                                border-width: root.accent-index == 2 ? 3px : 1px; border-color: root.accent-index == 2 ? Theme.text : Theme.border;
                                                TouchArea { clicked => { root.accent-index = 2; root.accent-changed(2); } }
                                            }
                                            Rectangle {
                                                width: 24px; height: 24px; border-radius: 12px; background: #EF4444;
                                                border-width: root.accent-index == 3 ? 3px : 1px; border-color: root.accent-index == 3 ? Theme.text : Theme.border;
                                                TouchArea { clicked => { root.accent-index = 3; root.accent-changed(3); } }
                                            }
                                            Rectangle {
                                                width: 24px; height: 24px; border-radius: 12px; background: #F59E0B;
                                                border-width: root.accent-index == 4 ? 3px : 1px; border-color: root.accent-index == 4 ? Theme.text : Theme.border;
                                                TouchArea { clicked => { root.accent-index = 4; root.accent-changed(4); } }
                                            }
                                            Rectangle {
                                                width: 24px; height: 24px; border-radius: 12px; background: #22C55E;
                                                border-width: root.accent-index == 5 ? 3px : 1px; border-color: root.accent-index == 5 ? Theme.text : Theme.border;
                                                TouchArea { clicked => { root.accent-index = 5; root.accent-changed(5); } }
                                            }
                                            Rectangle {
                                                width: 24px; height: 24px; border-radius: 12px; background: #71717A;
                                                border-width: root.accent-index == 6 ? 3px : 1px; border-color: root.accent-index == 6 ? Theme.text : Theme.border;
                                                TouchArea { clicked => { root.accent-index = 6; root.accent-changed(6); } }
                                            }
                                        }
                                    }
                                }
                                Card {
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 12px;
                                        SectionTitle { text: L.language; }
                                        VerticalLayout {
                                            spacing: 6px;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                LangButton { text: root.language-names[0]; selected: root.language-index == 0; clicked => { root.language-index = 0; root.language-changed(root.language-names[0]); } }
                                                LangButton { text: root.language-names[1]; selected: root.language-index == 1; clicked => { root.language-index = 1; root.language-changed(root.language-names[1]); } }
                                                LangButton { text: root.language-names[2]; selected: root.language-index == 2; clicked => { root.language-index = 2; root.language-changed(root.language-names[2]); } }
                                            }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                LangButton { text: root.language-names[3]; selected: root.language-index == 3; clicked => { root.language-index = 3; root.language-changed(root.language-names[3]); } }
                                                LangButton { text: root.language-names[4]; selected: root.language-index == 4; clicked => { root.language-index = 4; root.language-changed(root.language-names[4]); } }
                                                LangButton { text: root.language-names[5]; selected: root.language-index == 5; clicked => { root.language-index = 5; root.language-changed(root.language-names[5]); } }
                                            }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                LangButton { text: root.language-names[6]; selected: root.language-index == 6; clicked => { root.language-index = 6; root.language-changed(root.language-names[6]); } }
                                                LangButton { text: root.language-names[7]; selected: root.language-index == 7; clicked => { root.language-index = 7; root.language-changed(root.language-names[7]); } }
                                                LangButton { text: root.language-names[8]; selected: root.language-index == 8; clicked => { root.language-index = 8; root.language-changed(root.language-names[8]); } }
                                            }
                                        }
                                    }
                                }
                                Card {
                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            spacing: 3px;
                                            Text { text: L.autostart; color: Theme.text; font-size: 12px; font-weight: 500; }
                                            MutedText { text: L.autostart-desc; }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Switch { checked: root.autostart; toggled(v) => { root.autostart = v; root.set-autostart(v); } }
                                    }
                                }
                                Card {
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 10px;
                                        SectionTitle { text: L.host-sharing; }
                                        MutedText { text: L.host-password-desc; width: parent.width; wrap: word-wrap; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            InputBox {
                                                text <=> root.host-password-input;
                                                placeholder: root.host-password-set ? L.change-password : L.set-password;
                                                password: true;
                                                horizontal-stretch: 1;
                                            }
                                            TextButton {
                                                text: root.host-password-set ? L.change-password : L.set-password;
                                                primary: true;
                                                clicked => { root.set-host-password(root.host-password-input); }
                                            }
                                        }
                                        if !root.host-password-set : Text { text: L.status-no-host-password; color: Theme.warning; font-size: 10px; }
                                    }
                                }
                            }

                            if root.settings-tab == 1 : VerticalLayout {
                                spacing: 16px;
                                MutedText { text: L.share-printers-desc; width: parent.width; wrap: word-wrap; }
                                if root.local-printers.length == 0 : Text { text: L.no-local-printers; color: Theme.tertiary; font-size: 12px; }
                                for lp in root.local-printers : Card {
                                    height: 76px;
                                    HorizontalLayout {
                                        padding: 14px;
                                        spacing: 10px;
                                        cross-axis-alignment: center;
                                        Rectangle {
                                            width: 36px; height: 36px; border-radius: 8px; background: Theme.control;
                                            IconPrinter { x: 6px; y: 6px; tint: lp.shared ? Theme.accent : Theme.muted; }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            Text { text: lp.name; color: Theme.text; font-size: 12px; font-weight: 600; overflow: elide; }
                                            Text { text: lp.driver + " · " + lp.status; color: Theme.muted; font-size: 10px; overflow: elide; }
                                        }
                                        if lp.shared : Badge { text: lp.has-password ? "PIN" : L.shared; tone: Theme.accent; foreground: Theme.on-accent; }
                                        TextButton {
                                            text: L.printer-password;
                                            small: true;
                                            enabled: lp.shared;
                                            clicked => {
                                                root.password-target = lp.name;
                                                root.password-kind = 1;
                                                root.password-title = L.printer-password;
                                                root.password-input = "";
                                                root.password-open = true;
                                            }
                                        }
                                        Switch { checked: lp.shared; toggled(v) => { root.share-printer(lp.name, v); } }
                                    }
                                }
                            }

                            if root.settings-tab == 2 : VerticalLayout {
                                spacing: 16px;
                                Card {
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 11px;
                                        SectionTitle { text: L.cloud-title; }
                                        MutedText { text: L.cloud-enable-desc; width: parent.width; wrap: word-wrap; }
                                        HorizontalLayout {
                                            spacing: 10px;
                                            Text { text: L.cloud-enable; color: Theme.text; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                            Switch { checked: root.cloud-enabled; toggled(v) => { root.cloud-enabled = v; } }
                                        }
                                        Text { text: L.server-url; color: Theme.muted; font-size: 11px; }
                                        InputBox { text <=> root.cloud-server; placeholder: L.bridge-url-placeholder; }
                                        Text { text: L.server-code; color: Theme.muted; font-size: 11px; }
                                        InputBox { text <=> root.cloud-code; placeholder: L.server-code-placeholder; password: true; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            TextButton {
                                                text: L.cloud-save;
                                                primary: true;
                                                clicked => { root.cloud-save(root.cloud-enabled, root.cloud-server, root.cloud-code); }
                                            }
                                        }
                                        if root.share-code != "" : Rectangle {
                                            border-radius: 8px;
                                            background: Theme.field;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            HorizontalLayout {
                                                padding: 10px;
                                                spacing: 8px;
                                                VerticalLayout {
                                                    spacing: 2px;
                                                    Text { text: L.share-code; color: Theme.muted; font-size: 10px; }
                                                    Text { text: root.share-code; color: Theme.accent; font-size: 18px; font-weight: 700; letter-spacing: 2px; }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                                TextButton { text: L.copy-code; small: true; clicked => { root.copy-share-code(); } }
                                            }
                                        }
                                        MutedText { text: L.cloud-hint; width: parent.width; wrap: word-wrap; }
                                    }
                                }
                            }

                            if root.settings-tab == 3 : VerticalLayout {
                                spacing: 16px;
                                Card {
                                    VerticalLayout {
                                        padding: 18px;
                                        spacing: 9px;
                                        HorizontalLayout {
                                            spacing: 12px;
                                            Rectangle {
                                                width: 52px; height: 52px; border-radius: 12px;
                                                Image { source: @image-url("assets/lanprint-icon.png"); width: parent.width; height: parent.height; }
                                            }
                                            VerticalLayout {
                                                spacing: 2px; alignment: center;
                                                Text { text: L.app-name; color: Theme.text; font-size: 21px; font-weight: 700; }
                                                MutedText { text: L.app-tagline; }
                                            }
                                        }
                                        Text { text: L.version + ": " + root.version-text; color: Theme.muted; font-size: 11px; }
                                        Text { text: "MIT License · github.com/Kaiyuan/lanPrint"; color: Theme.tertiary; font-size: 10px; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            TextButton { text: L.docs; small: true; clicked => { root.open-docs(); } }
                                            TextButton { text: L.open-logs; small: true; clicked => { root.open-logs(); } }
                                            TextButton { text: L.quit; small: true; clicked => { root.quit-app(); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // -------------------------------------------------------- all printers sheet
    if root.all-printers-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.overlay;
        TouchArea { }
        Rectangle {
            width: Math.min(parent.width - 24px, 620px);
            height: Math.min(parent.height - 40px, 600px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 18px;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: Theme.shadow;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    Image { source: @image-url("assets/icons/list.svg"); width: 18px; height: 18px; colorize: Theme.accent; }
                    Text { text: L.all-printers-title + " · " + root.all-printers-name; color: Theme.text; font-size: 17px; font-weight: 600; overflow: elide; }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton { text: "×"; clicked => { root.all-printers-open = false; } }
                }
                if root.printers.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    Text { text: L.no-printers; color: Theme.tertiary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                }
                if root.printers.length > 0 : AppScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: parent.width;
                        spacing: 8px;
                        for p in root.printers : Rectangle {
                            height: 68px;
                            border-radius: 9px;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding: 12px;
                                spacing: 10px;
                                cross-axis-alignment: center;
                                Rectangle {
                                    width: 32px; height: 32px; border-radius: 8px; background: Theme.control;
                                    IconPrinter { x: 4px; y: 4px; tint: p.online ? Theme.accent : Theme.tertiary; }
                                }
                                VerticalLayout {
                                    spacing: 2px; alignment: center;
                                    Text { text: p.display-name; color: Theme.text; font-size: 12px; font-weight: 600; overflow: elide; }
                                    Text { text: p.driver; color: Theme.muted; font-size: 10px; overflow: elide; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                if p.has-password : Badge { text: "PIN"; tone: Theme.warning; foreground: Theme.on-accent; }
                                StatusDot { online: p.online; }
                                if p.added : Badge { text: L.added; tone: Theme.segment-bg; }
                                if !p.added : TextButton {
                                    text: L.add-printer;
                                    icon: @image-url("assets/icons/plus.svg");
                                    has-icon: true;
                                    primary: true;
                                    small: true;
                                    clicked => {
                                        if p.has-password {
                                            root.password-target = p.remote-name;
                                            root.password-kind = 2;
                                            root.password-title = L.printer-password;
                                            root.password-input = "";
                                            root.password-open = true;
                                        } else {
                                            root.add-printer(p.device-id, p.remote-name, "");
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    TextButton {
                        text: L.remove-host;
                        icon: @image-url("assets/icons/trash.svg");
                        has-icon: true;
                        horizontal-stretch: 0;
                        clicked => {
                            root.all-printers-open = false;
                            root.remove-device(root.all-printers-id);
                        }
                    }
                }
            }
        }
    }

    // --------------------------------------------------------- password sheet
    if root.password-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.overlay;
        TouchArea { }
        Rectangle {
            width: 440px;
            height: 246px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 18px;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: Theme.shadow;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: root.password-title; color: Theme.text; font-size: 16px; font-weight: 600; }
                MutedText { text: L.printer-password-desc; width: parent.width; wrap: word-wrap; }
                InputBox { text <=> root.password-input; placeholder: L.access-code-placeholder; password: true; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    TextButton { text: L.cancel; clicked => { root.close-password(); } }
                    TextButton {
                        text: L.confirm;
                        primary: true;
                        clicked => { root.password-confirm(root.password-kind, root.password-target, root.password-input); }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------- scan sheet
    if root.scan-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.overlay;
        TouchArea { }
        Rectangle {
            width: 480px;
            height: 410px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 18px;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: Theme.shadow;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    Text { text: L.scan-title; color: Theme.text; font-size: 16px; font-weight: 600; }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton { text: "×"; enabled: !root.scan-busy; clicked => { root.close-scan(); } }
                }
                Text { text: L.scan-resolution; color: Theme.muted; font-size: 11px; }
                Segmented {
                    labels: ["150 dpi", "200 dpi", "300 dpi", "600 dpi"];
                    current: root.scan-resolution-index;
                    changed(i) => { root.scan-resolution-index = i; }
                }
                Text { text: L.scan-color; color: Theme.muted; font-size: 11px; }
                Segmented {
                    labels: [L.scan-color, L.scan-gray, L.scan-bw];
                    current: root.scan-color-index;
                    changed(i) => { root.scan-color-index = i; }
                }
                Text { text: L.scan-source; color: Theme.muted; font-size: 11px; }
                Segmented {
                    labels: [L.flatbed, L.adf];
                    current: root.scan-source-index;
                    changed(i) => { root.scan-source-index = i; }
                }
                if root.scan-busy : Text { text: L.scan-in-progress; color: Theme.accent; font-size: 11px; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    TextButton { text: L.cancel; enabled: !root.scan-busy; clicked => { root.close-scan(); } }
                    TextButton {
                        text: L.start-scan;
                        primary: true;
                        enabled: !root.scan-busy;
                        clicked => { root.start-scan(root.scan-target, root.scan-resolution-index, root.scan-color-index, root.scan-source-index); }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------- job settings
    if root.job-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.overlay;
        TouchArea { }
        Rectangle {
            width: 480px;
            height: 540px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 18px;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: Theme.shadow;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                HorizontalLayout {
                    Text { text: root.job-title-text; color: Theme.text; font-size: 16px; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton { text: "×"; clicked => { root.close-job-settings(); } }
                }
                MutedText { text: L.job-settings-hint; width: parent.width; wrap: word-wrap; }
                Rectangle { height: 4px; }
                if root.job-has-duplex : Text { text: L.job-duplex; color: Theme.muted; font-size: 11px; }
                if root.job-has-duplex : Segmented {
                    labels: [L.job-duplex-off, L.job-duplex-long, L.job-duplex-short];
                    current: root.job-duplex-index;
                    changed(i) => { root.job-duplex-index = i; }
                }
                if root.job-has-booklet : HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        Text { text: L.job-booklet; color: Theme.text; font-size: 13px; }
                        MutedText { text: L.job-booklet-hint; wrap: word-wrap; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Switch {
                        checked: root.job-booklet;
                        toggled(v) => { root.job-booklet = v; }
                    }
                }
                if root.job-has-color : Text { text: L.job-colour; color: Theme.muted; font-size: 11px; }
                if root.job-has-color : Segmented {
                    labels: [L.job-colour-on, L.job-colour-off];
                    current: root.job-color-index;
                    changed(i) => { root.job-color-index = i; }
                }
                Text { text: L.job-paper; color: Theme.muted; font-size: 11px; }
                Select {
                    options: root.job-papers;
                    current: root.job-paper-index;
                    changed(i) => { root.job-paper-index = i; }
                }
                if root.job-sources.length > 0 : Text { text: L.job-source; color: Theme.muted; font-size: 11px; }
                if root.job-sources.length > 0 : Select {
                    options: root.job-sources;
                    current: root.job-source-index;
                    unset-label: L.job-source-default;
                    changed(i) => { root.job-source-index = i; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Text { text: L.job-copies; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        text: "−";
                        enabled: root.job-copies > 1;
                        clicked => { if (root.job-copies > 1) { root.job-copies = root.job-copies - 1; } }
                    }
                    Text { text: root.job-copies; color: Theme.text; font-size: 14px; font-weight: 600; width: 32px; horizontal-alignment: center; vertical-alignment: center; }
                    IconButton {
                        text: "+";
                        enabled: root.job-copies < root.job-max-copies;
                        clicked => { if (root.job-copies < root.job-max-copies) { root.job-copies = root.job-copies + 1; } }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    TextButton { text: L.cancel; clicked => { root.close-job-settings(); } }
                    TextButton { text: L.save; primary: true; clicked => { root.save-job-settings(); } }
                }
            }
        }
    }

    // --------------------------------------------------------- first run sheet
    if root.first-run-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.overlay;
        Rectangle {
            width: 500px;
            height: 390px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 20px;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 16px;
            drop-shadow-color: Theme.shadow;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 26px;
                spacing: 13px;
                Text { text: L.first-run-title; color: Theme.text; font-size: 22px; font-weight: 700; }
                Text { text: L.first-run-desc; color: Theme.muted; font-size: 12px; wrap: word-wrap; width: parent.width; }
                InputBox { text <=> root.first-run-password; placeholder: L.access-code-placeholder; password: true; }
                MutedText { text: L.host-password-desc; width: parent.width; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    TextButton { text: L.skip; clicked => { root.skip-first-run(); } }
                    TextButton {
                        text: L.first-run-set;
                        primary: true;
                        clicked => { root.set-first-run-password(root.first-run-password); }
                    }
                }
            }
        }
    }

    // -------------------------------------------------------------------- toast
    if root.toast-open : Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 92px;
        width: 500px;
        height: 42px;
        border-radius: 11px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        Text {
            text: root.toast-text;
            color: Theme.text;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
            wrap: word-wrap;
        }
        TouchArea { clicked => { root.toast-close(); } }
    }
}


// Tray menu is a separate component because a SystemTrayIcon cannot share the
// window's globals. The Rust side feeds translated menu labels into it.
export component TrayIcon inherits SystemTrayIcon {
    in property <string> open-text: "Open lanPrint";
    in property <string> quit-text: "Quit";
    icon: @image-url("assets/lanprint-icon.png");
    tooltip: "lanPrint";
    title: "lanPrint";
    callback open();
    callback quit();
    Menu {
        MenuItem {
            title: root.open-text;
            activated => { root.open(); }
        }
        MenuSeparator { }
        MenuItem {
            title: root.quit-text;
            activated => { root.quit(); }
        }
    }
    clicked => { root.open(); }
}
